{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "blog",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8000"],
      "port": 8000
    },
    {
      "name": "blog-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-c", "import os,http.server,socketserver;socketserver.TCPServer(('',int(os.environ.get('PORT','8010'))),http.server.SimpleHTTPRequestHandler).serve_forever()"],
      "port": 8010,
      "autoPort": true
    }
  ]
}
