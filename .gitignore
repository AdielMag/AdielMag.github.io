# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# agent skill scaffolding (installed via `npx skills add`)
.agents/
skills-lock.json

# installed skills are ignored, but hand-written project skills are tracked.
# `.claude/skills/*` rather than `.claude/skills/` so git still descends into
# the directory - it will not look inside an excluded one, so the negation
# below would never match.
.claude/skills/*
!.claude/skills/blog-post/
